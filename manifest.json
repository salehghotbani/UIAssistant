{
  "manifest_version": 3,
  "name": "UIAssistant",
  "version": "0.8.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "author": "saleh ghotbani",
  "homepage_url": "https://github.com/salehghotbani/UIAssistant",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "offscreen", "clipboardWrite"],
  "externally_connectable": { "ids": [], "matches": [] },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_extensionTitle__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "pick-color": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Pick a color from the page"
    },
    "resample": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Resample the last page location"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+U"
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; connect-src 'none'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; form-action 'none'"
  }
}
